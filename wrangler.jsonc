{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "raysite-cms0",
	"compatibility_date": "2025-08-03",
	"main": "./src/index.ts",
	"r2_buckets": [
		{
			"binding": "raysite_cms0_assets",
			"bucket_name": "raysite-cms0-assets",
			"preview_bucket_name": "raysite-cms0-assets-preview"
		}
	],
	"d1_databases": [
		{
			"binding": "raysite_cms0_db",
			"database_name": "raysite-cms0-db",
			"database_id": "3cde22c9-8c24-4ba4-a97e-8dff693771bb",
			"migrations_dir": "migrations"
		}
	]
}