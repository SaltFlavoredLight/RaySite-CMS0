{
  "name": "raysite-cms0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply raysite-cms0-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply raysite-cms0-db --remote",
    "r2:list": "wrangler r2 bucket list"
  },
  "dependencies": {
    "better-auth": "^1.7.21",
    "hono": "^4.13.16",
    "prosemirror-collab": "^1.3.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.2",
    "prosemirror-menu": "^1.2.5",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.10.4",
    "prosemirror-view": "^1.41.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@hono/vite-dev-server": "^0.26.1",
    "astro": "^7.4.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
